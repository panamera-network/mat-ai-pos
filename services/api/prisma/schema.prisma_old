//services/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") // optional
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

enum EmploymentType {
  HOURLY_PART_TIME
  MONTHLY_SALARIED
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum OrderSource {
  QR_MENU
  POS
  ONLINE
  PHONE
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
  RESERVATION
}

enum PaymentMethod {
  CASH
  CARD
  EWALLET
  QR_PAY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum StockType {
  AUTO_DEDUCT
  MANUAL_IN
  ADJUSTMENT
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollPeriod {
  WEEKLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

// ==================== CORE ====================

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String              @id @default(cuid())
  name        String              @unique
  price       Decimal
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id])
  imageUrl    String?
  isAvailable Boolean             @default(true)
  stock       Int                 @default(0)
  minStock    Int                 @default(0)
  options     Json?
  ingredients MenuItemIngredient[] // ← NEW: recipe (hidden from cashier)
  stockLogs   StockLog[]
  orderItems  OrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Table {
  id        String      @id @default(cuid())
  number    String      @unique
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  orders    Order[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ==================== ORDERS ====================

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  source          OrderSource @default(POS)
  type            OrderType   @default(DINE_IN)
  totalAmount     Decimal
  paidAmount      Decimal?
  taxAmount       Decimal?
  paymentMethod   PaymentMethod?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  tableId         String?
  table           Table?      @relation(fields: [tableId], references: [id])
  pax             Int?
  reservationTime DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?
  items           OrderItem[]
  receipt         Receipt?
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id])
  name        String
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  options     Json?
  notes       String?
  status      ItemStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== STAFF ====================

model Staff {
  id              String         @id @default(cuid())
  name            String         @unique
  pin             String
  role            Role           @default(CASHIER)
  isActive        Boolean        @default(true)
  employmentType  EmploymentType @default(HOURLY_PART_TIME)
  hourlyRate      Decimal?
  monthlySalary   Decimal?
  joinDate        DateTime       @default(now())
  customEpfRate   Decimal?
  customSocsoRate Decimal?
  timecards       Timecard[]
  receipts        Receipt[]
  stockLogs       StockLog[]
  payrolls        Payroll[]
  leaveRequests   LeaveRequest[]
  advances        StaffAdvance[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Timecard {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  clockIn       DateTime
  clockOut      DateTime?
  breakMinutes  Int       @default(0)
  totalMinutes  Int?
  totalHours    Decimal?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

// ==================== LEAVE ====================

model LeaveRequest {
  id               String      @id @default(cuid())
  staffId          String
  staff            Staff       @relation(fields: [staffId], references: [id])
  type             LeaveType
  startDate        DateTime
  endDate          DateTime
  days             Int
  reason           String?
  status           LeaveStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  payrollDeduction Decimal?
  createdAt        DateTime    @default(now())
}

// ==================== ADVANCE ====================

model StaffAdvance {
  id                String             @id @default(cuid())
  staffId           String
  staff             Staff              @relation(fields: [staffId], references: [id])
  amount            Decimal
  reason            String?
  takenAt           DateTime           @default(now())
  totalInstallments Int                @default(1)
  paidInstallments  Int                @default(0)
  installmentAmount Decimal
  isFullyPaid       Boolean            @default(false)
  paidOffAt         DateTime?
  deductions        AdvanceDeduction[]
  createdAt         DateTime           @default(now())
}

model AdvanceDeduction {
  id        String       @id @default(cuid())
  advanceId String
  advance   StaffAdvance @relation(fields: [advanceId], references: [id])
  payrollId String
  payroll   Payroll      @relation(fields: [payrollId], references: [id])
  amount    Decimal
  createdAt DateTime     @default(now())
}

// ==================== PAYROLL ====================

model Payroll {
  id                String             @id @default(cuid())
  staffId           String
  staff             Staff              @relation(fields: [staffId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  periodType        PayrollPeriod
  basicPay          Decimal
  overtimeHours     Decimal            @default(0)
  overtimePay       Decimal            @default(0)
  totalEarnings     Decimal
  leaveDeduction    Decimal            @default(0)
  epfEmployee       Decimal            @default(0)
  epfEmployer       Decimal            @default(0)
  socsoEmployee     Decimal            @default(0)
  socsoEmployer     Decimal            @default(0)
  advanceDeduction  Decimal            @default(0)
  otherDeductions   Decimal            @default(0)
  totalDeductions   Decimal
  nettPay           Decimal
  status            PayrollStatus      @default(DRAFT)
  paidAt            DateTime?
  paidBy            String?
  pdfUrl            String?
  advanceDeductions AdvanceDeduction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ==================== RECEIPTS ====================

model Receipt {
  id             String   @id @default(cuid())
  receiptNo      String   @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  totalAmount    Decimal
  paidAmount     Decimal
  change         Decimal?
  paymentMethod  String
  taxAmount      Decimal?
  cashierId      String
  cashier        Staff    @relation(fields: [cashierId], references: [id])
  posId          String
  itemsSnapshot  Json
  customerInfo   Json?
  printCount     Int      @default(0)
  lastPrintedAt  DateTime?
  pdfGeneratedAt DateTime?
  pdfUrl         String?
  emailedTo      String?
  emailSentAt    DateTime?
  createdAt      DateTime @default(now())
}

// ==================== INVENTORY ====================

model StockLog {
  id              String          @id @default(cuid())
  type            StockType       // AUTO_DEDUCT | MANUAL_IN | ADJUSTMENT
  menuItemId      String?
  menuItem        MenuItem?       @relation(fields: [menuItemId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  orderId         String?
  reason          String?
  staffId         String?         // nullable
  staff           Staff?           @relation(fields: [staffId], references: [id])
  createdAt       DateTime        @default(now())
}

// ==================== INVENTORY (Raw Material) ====================

model InventoryItem {
  id            String             @id @default(cuid())
  name          String             @unique
  category      String             // frozen, chiller, cheese, vegetables, dry, sauce, pasta, oil
  unit          String             @default("g") // g, kg, ml, l, pcs
  weight        Float?             // ← ADDED: per unit/pack in grams
  currentStock  Float              @default(0)
  minStock      Float              @default(0)
  costPerUnit   Float?             // ← ADDED: for COGS tracking
  supplier      String?
  isActive      Boolean            @default(true)
  
  ingredients   MenuItemIngredient[]
  stockLogs     StockLog[]
  
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// Link: InventoryItem → MenuItem (recipe / BOM)
model MenuItemIngredient {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  quantityUsed    Float         // e.g., 200g per serving (staff tak nampak ni)
  
  createdAt       DateTime      @default(now())
}

// ==================== SETTINGS ====================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}