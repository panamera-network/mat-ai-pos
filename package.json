{
  "name": "mat-ai-pos",
  "version": "1.0.0",
  "private": true,
  "description": "MAT.ai POS - Smart Restaurant Point of Sale System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "MAT.ai Team",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "pos:dev": "pnpm --filter @mat-ai/pos dev",
    "pos:build": "pnpm --filter @mat-ai/pos build",
    "kitchen:dev": "pnpm --filter @mat-ai/kitchen dev",
    "admin:dev": "pnpm --filter @mat-ai/admin dev",
    "qr:dev": "pnpm --filter @mat-ai/qr-menu dev"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}